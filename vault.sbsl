@Глобально
структура шаблонСекретов
    обз пер data: Объект
;

@Глобально
структура хранилищеСекретов
    обз пер адресСервера: Строка
    обз пер токенДоступа: Строка 
    обз пер имяХранилища: Строка

    @Глобально
    метод получитьСекреты(): Строка
        исп запрос = КлиентHttp.СБазовымUrl(адресСервера)
            .ЗапросGet("/v1/secret/data/%имяХранилища")
                .ДобавитьЗаголовок("X-Vault-Token", " %токенДоступа")
            .Выполнить()

        пер строкаДанных = ""
        
        если запрос.КодСтатуса == 200 
            пер результат = СериализацияJson.ПрочитатьОбъект(запрос.Тело, Тип<Соответствие<Строка, Объект?>>)
            пер данные = результат.Получить("data") как Соответствие<Строка, Объект?>
            строкаДанных = СериализацияJson.ЗаписатьОбъект(данные)
        иначе 
            Консоль.Записать(запрос.КодСтатуса)
            Консоль.Записать(запрос.Тело.ВСтроку())
        ;
        
        возврат строкаДанных
    ;  

    @Глобально
    метод записатьСекреты(новыеСекреты: шаблонСекретов)
        пер настройки = новый НастройкиЗаписиОбъектовJson()
        настройки.РежимЗаписиТипа = РежимЗаписиТипаJson.НеЗаписывать
        пер секретыСтрокой = СериализацияJson.ЗаписатьОбъект(новыеСекреты, настройки)
        
        исп запрос = КлиентHttp.СБазовымUrl(адресСервера)
            .ЗапросPatch("/v1/secret/data/%имяХранилища")
                .ДобавитьЗаголовок("X-Vault-Token", " %токенДоступа")
                .ДобавитьЗаголовок("Content-Type", "application/merge-patch+json")
                .УстановитьТело(секретыСтрокой)
            .Выполнить()
        
        если запрос.КодСтатуса != 200
            Консоль.Записать("Произошла ошибка записи секретов")    
        ;
        
        
    ;
;