@Глобально
структура Клиент
    обз пер адресСервера: Строка
    обз пер логин: Строка
    обз пер пароль: Строка
    обз пер имяПроекта: Строка
    пер имяВетки: Строка = "Unit"
    пер имяКонфига: Строка = "jobConfigurationRC.json"

    @Глобально
    метод запуститьПайплайнСПараметрами()
        пер аутентификация =
            новый АутентификацияHttp(логин, пароль, СхемаАутентификацииHttp.Базовая)
        пер клиент = КлиентHttp.СБазовымUrl(адресСервера).САутентификацией(аутентификация)
        исп клиент.ЗапросPost("/job/%имяПроекта/job/%имяВетки/buildWithParameters?CONFIGPATH=%имяКонфига").Выполнить()
    ;

    @Глобально 
    метод статусСборки(номерСборки: Строка = "lastBuild"): Соответствие<Строка, Объект>
        пер аутентификация =
            новый АутентификацияHttp(логин, пароль, СхемаАутентификацииHttp.Базовая)
        пер клиент = КлиентHttp.СБазовымUrl(адресСервера).САутентификацией(аутентификация)   
        исп ответ = клиент.ЗапросPost("/job/%имяПроекта/job/%имяВетки/%номерСборки/api/json").Выполнить() 
        пер тело = СериализацияJson.ПрочитатьОбъект(ответ.Тело) как Соответствие<Строка, Объект?>
        пер результаты = новый Соответствие<Строка, Объект>()
        результаты.Вставить("Выполняется", тело.Получить("building"))
        результаты.Вставить("СтатусСборки", тело.Получить("result").ВСтроку())
        результаты.Вставить("НомерСборки", тело.Получить("id").ВСтроку())
        возврат результаты
    ;
;
//http://10.172.2.135:2603 vostok  Check_AISVostok
метод Скрипт()
;