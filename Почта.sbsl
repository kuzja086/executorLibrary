@Глобально
@JsonОбъект(ИгнорироватьНеизвестные = Истина, ПропускатьПустыеЗначения = Истина)
структура Клиент
    @JsonСвойство(Псевдонимы = {"sender"})
    пер адресПочты: Строка

    @JsonСвойство(Псевдонимы = {"port"})
    пер порт: Число

    @JsonСвойство(Псевдонимы = {"server"})
    пер сервер: Строка

    @JsonСвойство(Псевдонимы = {"user"})
    пер пользователь: Строка

    @JsonСвойство(Псевдонимы = {"password"})
    пер пароль: Строка

    @JsonСвойство(Псевдонимы = {"use"})
        пер использовать: Булево = Истина

    @JsonСвойство(Псевдонимы = {"recivers"})
        пер получатели: Массив<Строка> = []

    @Глобально
    метод отправитьПисьмо(тема: Строка, текстСообщения: Строка, списокВложений: Соответствие<Строка, Файл|Строка>)
        если не использовать
            возврат
        ;
        пер Аутентификация = новый АутентификацияПочтыПоПаролю(пользователь, пароль)
        пер ПараметрыПодключения = новый ПараметрыПодключенияSmtp(сервер, порт, Аутентификация)
        ПараметрыПодключения.ИспользоватьSsl = Ложь
        ПараметрыПодключения.РазрешитьStartTls = Истина
        ПараметрыПодключения.ТаймаутПередачиДанных = 1м30с
        ПараметрыПодключения.ТаймаутСоединения = 1м30с
        пер письмо = новый Письмо(адресПочты)
        письмо.Тема = тема
        для получатель из получатели
            письмо.ДобавитьПолучателей(получатель)
        ;

        для вложение из списокВложений
            письмо.ПриложитьФайл(вложение.Значение, вложение.Ключ)
        ;

        письмо.УстановитьТекстКакСтроку(текстСообщения, ВидТекстаПисьма.Html)
        КлиентSmtp.Отправить(ПараметрыПодключения, письмо)
    ;
;