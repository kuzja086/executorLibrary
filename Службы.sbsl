@Глобально
перечисление командаСлужбы
    Запустить
    Остановить
;

@Глобально
перечисление состояниеСлужбы
    Запущена
    Остановлена
;

@Глобально
структура параметрыСлужб
    обз пер имяСлужбы: Строка
    пер команда: командаСлужбы = командаСлужбы.Запустить
    пер удаленныйСервер: Булево = Ложь
    пер имяСервера: Строка = ""
    пер пользовательУдаленногоСервера: Строка = ""
    пер парольУдаленногоСервера: Строка = ""

    @Глобально
    метод получитьСостояниеСлужбы(потокЛога: ПотокЗаписи): состояниеСлужбы
        записатьЛог("Получение статуса службы: %{имяСлужбы}", потокЛога)

        пер выводКоманды = ""
        пер параметрыЗапуска = новый Массив<Строка>()

        параметрыЗапуска.Добавить("query")
        параметрыЗапуска.Добавить(имяСлужбы)
        если удаленныйСервер
            пер процесс =
                новый ПроцессОс("net", ["use", "\\\\%имяСервера", парольУдаленногоСервера, "/user:%пользовательУдаленногоСервера"])
            параметрыЗапуска.Вставить(0, "\\\\%имяСервера")
            процесс.ПередатьВыводВ("sc", параметрыЗапуска)
            процесс.Запустить()
            процесс.ОжидатьЗавершения(3м)
            выводКоманды = процесс.ПолучитьПотокВывода().ПрочитатьКакСтроку()
        иначе
            пер процесс = новый ПроцессОс("sc", параметрыЗапуска)
            процесс.Запустить()
            процесс.ОжидатьЗавершения(3м)
            выводКоманды = процесс.ПолучитьПотокВывода().ПрочитатьКакСтроку()
        ;

        записатьЛог(выводКоманды, потокЛога)

        знч образец = '(STATE.+:\s\d\s+)(\w+)'
        пер рез = образец.НайтиСовпадения(выводКоманды)
        если рез.Пусто()
            пер текстОшибки = "Не удалось получить состояние службы: %имяСлужбы"
            записатьЛог(текстОшибки, потокЛога)
            выбросить новый ИсключениеИндексВнеГраниц(текстОшибки)
        ;
        пер статусСлужбы = рез.Первый().Группа(2)

        пер результат = состояниеСлужбы.Запущена
        если статусСлужбы == "STOPPED"
            результат = состояниеСлужбы.Остановлена
        ;

        возврат результат
    ;

    @Глобально
    метод изменитьСостояниеСлужбы(потокЛога: ПотокЗаписи): Число?
        пер значениеКоманды = "start"
        если команда == командаСлужбы.Остановить
            значениеКоманды = "stop"
        ;
        пер параметрыЗапуска = новый Массив<Строка>()
        параметрыЗапуска.Добавить(значениеКоманды)
        параметрыЗапуска.Добавить(имяСлужбы)

        пер процесс = новый ПроцессОс("sc", параметрыЗапуска)
        процесс.Запустить()
        процесс.ОжидатьЗавершения(3м)

        пер кодВозврата = процесс.ПолучитьКодВозврата()
        если кодВозврата == 0
            записатьЛог("Состояние службы %имяСлужбы изменено: %значениеКоманды", потокЛога)
        иначе
            записатьЛог("Ошибка изменения состояния службы %имяСлужбы", потокЛога)
            записатьЛог(процесс.ПолучитьПотокВывода().ПрочитатьКакСтроку(), потокЛога)
        ;
        возврат кодВозврата
    ;

    @Локально
    метод записатьЛог(текст: Строка, потокЛога: ПотокЗаписи)
        Консоль.Записать(текст)
        потокЛога.Записать(текст)
        потокЛога.Записать(Символы.НОВАЯ_СТРОКА)
        потокЛога.Записать(Символы.НОВАЯ_СТРОКА)
    ;
;