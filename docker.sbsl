@Глобально 
структура результат
    пер кодВозврата: Число
    пер текст: Строка
;

@Глобально
метод ПерезапуститьКонтейнер(имяКонтейнера: Строка): результат
    пер рез = новый результат()
    пер МассивПараметровЗапуска = новый Массив<Строка>()

    МассивПараметровЗапуска.Добавить("container")
    МассивПараметровЗапуска.Добавить("restart")
    МассивПараметровЗапуска.Добавить(имяКонтейнера)

    пер Процесс: ПроцессОс = новый ПроцессОс("docker", МассивПараметровЗапуска)
    Процесс.Запустить()
    Процесс.ОжидатьЗавершения(30с)
    рез.кодВозврата = Процесс.ПолучитьКодВозврата()
    рез.текст = Процесс.ПолучитьПотокВывода().ПрочитатьКакСтроку("cp866")
    возврат рез    
;
