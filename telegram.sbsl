@Глобально
структура Клиент
    пер токен: Строка
    пер чатИД: Строка

    @Глобально
    метод отправитьСообщение(текстСообщения: Строка)
        пер параметрыЗащиты = новый ПараметрыЗащищенногоСоединения(СистемноеХранилищеСертификатов)
        пер клиент = КлиентHttp.СБазовымUrl("https://api.telegram.org:443").СПараметрамиЗащиты(параметрыЗащиты)
        пер запрос = клиент.ЗапросGet("/bot%токен/sendMessage?chat_id=%чатИД&text=%текстСообщения")
        исп ответ = запрос.Выполнить()
        ответ.Закрыть()
    ;
;

метод Скрипт()
;